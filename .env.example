# Copy this file to ".env" (same folder as manage.py) and fill in YOUR values.
# ".env" is ignored by git, so your password never reaches GitHub.

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=chaiyo_db
DB_USER=postgres
DB_PASSWORD=12345678
DB_HOST=localhost
DB_PORT=5432

# The frontend (chai-yo-para-frontend) runs on VS Code Live Server:
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
