# Copy this file to ".env" (same folder as manage.py) and fill in YOUR values.
# ".env" is ignored by git, so your password never reaches GitHub.

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=chaiyo_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Live Server (5500) and Vite (5173) are allowed by default; change only if your frontend uses another address.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:5173,http://127.0.0.1:5173
